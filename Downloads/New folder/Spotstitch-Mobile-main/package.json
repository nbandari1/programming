    "react-native-tab-view": "^4.1.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/color": "^4.2.0",
    "@types/react": "~18.3.12",
    "@types/react-native-vector-icons": "^6.4.18",
    "eslint": "^9.27.0",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.0.0",
    "prettier": "^3.5.3",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.32.1"
  },
  "private": true,
  "name": "spotsitch-mobile",
  "version": "0.0.1",
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 10"
